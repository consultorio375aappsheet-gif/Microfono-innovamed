<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dictado Continuo Consulta - DRA. ELIZABETH BALL DE PICÓN | Innova Med</title>
  <style>
    :root {
      --primary-color: #932938; /* Rojo borgoña corporativo */
      --primary-hover: #751f2b;
      --secondary-color: #2c3e50;
      --bg-color: #eef2f5;
      --card-bg: #ffffff;
      --border-color: #d1d5db;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: 'Georgia', 'Times New Roman', serif;
      margin: 0;
      padding: 20px 10px;
      background-color: var(--bg-color);
      color: #222;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }

    /* Contenedor estilo Hoja Médica / Informe */
    .sheet-container {
      width: 100%;
      max-width: 820px;
      background: var(--card-bg);
      padding: 40px 45px;
      border-radius: 6px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08), 0 2px 6px rgba(0, 0, 0, 0.04);
      border: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
    }

    /* Encabezado Corporativo */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid var(--primary-color);
      padding-bottom: 18px;
      margin-bottom: 25px;
      gap: 15px;
      width: 100%;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .clinic-info {
      text-align: right;
      font-family: 'Arial', sans-serif;
      font-size: 12px;
      color: #444;
      line-height: 1.4;
    }

    .clinic-info strong {
      font-size: 14px;
      color: var(--secondary-color);
      display: block;
      margin-bottom: 2px;
    }

    /* Título de la sección */
    .document-title {
      text-align: center;
      font-size: 20px;
      font-weight: bold;
      color: var(--secondary-color);
      text-decoration: none;
      text-underline-offset: 6px;
      margin-bottom: 20px;
      text-transform: uppercase;
      letter-spacing: 1px;
      width: 100%;
    }

    /* Barra de Estado */
    .status-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      padding: 10px 18px;
      border-radius: 6px;
      margin-bottom: 20px;
      font-family: 'Arial', sans-serif;
      font-size: 14px;
      width: 100%;
    }

    .status-indicator {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      color: #475569;
    }

    .status-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background-color: #94a3b8;
    }

    .status-dot.active {
      background-color: #10b981;
      box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0% { opacity: 1; }
      50% { opacity: 0.4; }
      100% { opacity: 1; }
    }

    /* Controles y Botones */
    .controls {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin-bottom: 20px;
      font-family: 'Arial', sans-serif;
      width: 100%;
    }

    button {
      padding: 12px 22px;
      font-size: 14px;
      font-family: 'Arial', sans-serif;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    button:active {
      transform: translateY(1px);
    }

    #start-btn {
      background-color: #10b981;
      color: white;
      box-shadow: 0 2px 4px rgba(16, 185, 129, 0.2);
    }

    #start-btn:hover:not(:disabled) {
      background-color: #059669;
    }

    #stop-btn {
      background-color: #ef4444;
      color: white;
      box-shadow: 0 2px 4px rgba(239, 68, 68, 0.2);
    }

    #stop-btn:hover:not(:disabled) {
      background-color: #dc2626;
    }

    #save-btn {
      background-color: var(--primary-color);
      color: white;
      width: 100%;
      margin-top: 20px;
      padding: 15px;
      font-size: 15px;
      border-radius: 5px;
      box-shadow: 0 4px 10px rgba(147, 41, 56, 0.2);
    }

    #save-btn:hover:not(:disabled) {
      background-color: var(--primary-hover);
    }

    button:disabled {
      background-color: #cbd5e1 !important;
      color: #94a3b8 !important;
      cursor: not-allowed;
      box-shadow: none !important;
    }

    /* Caja de Transcripción Estilizada */
    textarea {
      width: 100%;
      height: 260px;
      padding: 18px;
      font-family: 'Georgia', 'Times New Roman', serif;
      font-size: 16px;
      color: #1e293b;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      background-color: #fafafa;
      resize: vertical;
      line-height: 1.6;
      box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.03);
    }

    textarea:focus {
      outline: none;
      border-color: var(--primary-color);
      background-color: #ffffff;
    }

    .footer-credits {
      text-align: center;
      font-family: 'Arial', sans-serif;
      font-size: 11px;
      color: #94a3b8;
      margin-top: 15px;
      width: 100%;
    }

    /* Adaptabilidad Móvil */
    @media (max-width: 600px) {
      .sheet-container {
        padding: 20px 18px;
      }

      .header {
        flex-direction: column;
        text-align: center;
        gap: 10px;
      }

      .clinic-info {
        text-align: center;
      }

      .controls {
        flex-direction: column;
      }

      button {
        width: 100%;
      }
    }
  </style>
</head>
<body>

  <div class="sheet-container">
    <!-- Encabezado Corporativo estilo Informe Médico -->
    <div class="header">
      <div class="brand-logo">
        <img src="https://lh3.googleusercontent.com/d/1Tlf8Sn2I2glfRitRd3sbaMan3A1WVaAU" 
             alt="Innova Med Logo" 
             style="height: 160px; width: auto; object-fit: contain;">
      </div>
      <div class="clinic-info">
        <strong>CONSULTORIO MÉDICO DERMATOLÓGICO</strong>
        DRA. ELIZABETH BALL DE PICÓN <br>
        Caracas 
      </div>
    </div>

    <div class="document-title">Dictado de Consulta Médica</div>

    <!-- Indicador de Estado -->
    <div class="status-container">
      <div class="status-indicator">
        <div id="status-dot" class="status-dot"></div>
        <span id="status">Estado: Detenido</span>
      </div>
      <span style="font-size: 12px; color: #64748b; font-family: sans-serif;">Dictado Inteligente IA</span>
    </div>

    <!-- Botones de Control -->
    <div class="controls">
      <button id="start-btn" onclick="startDictation()">🎙️ Iniciar Escucha</button>
      <button id="stop-btn" onclick="stopDictation()" disabled>⏹ Pausar</button>
    </div>

    <!-- Área de Texto Dictado -->
    <textarea id="transcript-box" placeholder="El texto dictado por la doctora aparecerá en esta sección de forma continua..."></textarea>

    <!-- Botón de Guardado -->
    <button id="save-btn" onclick="sendToAppSheet()">💾 Guardar Resumen</button>
    
    <div class="footer-credits">Innova Med Platform • Sistema de Asistencia Clínica</div>
  </div>

  <script>
    var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    var recognition = null;
    var isListening = false;
    var restartTimer = null;
    var baseTranscript = ''; // Acumula el texto grabado previo a cada inicio/reinicio en PC/Windows

    // Detectar si el dispositivo es Android
    var isAndroid = /Android/i.test(navigator.userAgent);

    if (SpeechRecognition) {
      recognition = new SpeechRecognition();
      recognition.continuous = true;
      recognition.lang = 'es-ES';

      // ⚠️ CLAVE PARA ANDROID: Desactivar resultados intermedios elimina los bucles y repeticiones.
      // En iOS/PC se mantiene activo (true) para fluidez en tiempo real.
      recognition.interimResults = !isAndroid;

      // ============================================================
      // MANEJO EXCLUSIVO Y LIMPIO PARA ANDROID Y OTROS SISTEMAS
      // ============================================================
      recognition.onresult = function(event) {
        var box = document.getElementById('transcript-box');

        if (isAndroid) {
          // Lógica Android Intacta: Capturamos únicamente frases finales completas
          for (var i = event.resultIndex; i < event.results.length; ++i) {
            if (event.results[i].isFinal) {
              var newPhrase = event.results[i][0].transcript.trim();
              if (newPhrase.length > 0) {
                var currentText = box.value.trim();
                if (currentText.length > 0) {
                  box.value = currentText + " " + newPhrase;
                } else {
                  box.value = newPhrase;
                }
              }
            }
          }
        } else {
          // Lógica PC / Windows (Tiempo real preservando el texto anterior)
          var sessionFinal = '';
          var interimText = '';
          for (var i = 0; i < event.results.length; ++i) {
            if (event.results[i].isFinal) {
              sessionFinal += event.results[i][0].transcript + ' ';
            } else {
              interimText += event.results[i][0].transcript;
            }
          }
          
          var totalText = baseTranscript + sessionFinal + interimText;
          box.value = totalText.replace(/\s+/g, ' ').trimStart();
        }
      };

      recognition.onerror = function(event) {
        console.warn("Error Speech:", event.error);
        if (event.error === 'no-speech' || event.error === 'aborted') {
          return;
        }
        document.getElementById('status').innerText = "Error: " + event.error;
        var dot = document.getElementById('status-dot');
        if (dot) dot.classList.remove('active');
      };

      recognition.onend = function() {
        if (isListening) {
          clearTimeout(restartTimer);
          restartTimer = setTimeout(function() {
            if (isListening && recognition) {
              // En PC/Windows guardamos el estado del texto antes de que la API reinicie
              if (!isAndroid) {
                var currentBox = document.getElementById('transcript-box').value.trim();
                baseTranscript = currentBox ? currentBox + " " : "";
              }
              try { recognition.start(); } catch (e) {}
            }
          }, 300);
        } else {
          document.getElementById('status').innerText = "Estado: Pausado";
          var dot = document.getElementById('status-dot');
          if (dot) dot.classList.remove('active');
          document.getElementById('start-btn').disabled = false;
          document.getElementById('stop-btn').disabled = true;
        }
      };

    } else {
      alert("Tu navegador no soporta el reconocimiento de voz nativo.");
    }

    function startDictation() {
      if (recognition && !isListening) {
        var boxText = document.getElementById('transcript-box').value.trim();
        baseTranscript = boxText ? boxText + " " : "";

        isListening = true;
        try {
          recognition.start();
          document.getElementById('status').innerText = "Estado: Escuchando...";
          var dot = document.getElementById('status-dot');
          if (dot) dot.classList.add('active');
          document.getElementById('start-btn').disabled = true;
          document.getElementById('stop-btn').disabled = false;
        } catch (e) {
          isListening = false;
        }
      }
    }

    function stopDictation() {
      if (recognition && isListening) {
        isListening = false;
        clearTimeout(restartTimer);
        try { recognition.stop(); } catch (e) {}

        var dot = document.getElementById('status-dot');
        if (dot) dot.classList.remove('active');
        document.getElementById('status').innerText = "Estado: Pausado";
        document.getElementById('start-btn').disabled = false;
        document.getElementById('stop-btn').disabled = true;
      }
    }

    // ENVÍO DE DATOS A APPSHEET
    async function sendToAppSheet() {
      var saveBtn = document.getElementById('save-btn');
      var text = document.getElementById('transcript-box').value;

      if (!text.trim()) {
        alert("No hay texto dictado para enviar.");
        return;
      }

      var urlParams = new URLSearchParams(window.location.search);
      var idPaciente = urlParams.get('idPaciente') || urlParams.get('rowId');

      if (!idPaciente) {
        alert("Error: No se encontró el ID del paciente en la URL.");
        return;
      }

      saveBtn.disabled = true;
      saveBtn.innerText = "Guardando...";

      var appId = 'f34969f7-116c-4d6e-bd99-e8988bf64a10';
      var accessKey = 'V2-glUCy-fR4MC-pZrWR-eJYyl-2C87z-ZiKdG-w6Kp1-7Ppep';
      var tableName = 'InformeMedico';

      var nuevoInformeId = "INF-" + Date.now();
      
      var hoy = new Date();
      var dia = String(hoy.getDate()).padStart(2, '0');
      var mes = String(hoy.getMonth() + 1).padStart(2, '0');
      var anio = hoy.getFullYear();
      var fechaHoy = dia + '/' + mes + '/' + anio;

      var payload = {
        "Action": "Add",
        "Properties": {
          "Locale": "es-ES",
          "Timezone": "UTC"
        },
        "Rows": [
          {
            "InformeMedID": nuevoInformeId,
            "IDPaciente": decodeURIComponent(idPaciente).trim(),
            "Fecha": fechaHoy,
            "Transcripción": text.trim()
          }
        ]
      };

      var apiUrl = 'https://api.appsheet.com/api/v2/apps/' + appId + '/tables/' + tableName + '/Action';

      try {
        var response = await fetch(apiUrl, {
          method: 'POST',
          headers: {
            'ApplicationAccessKey': accessKey,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        var resText = await response.text();

        if (response.ok) {
          alert("¡Informe guardado con éxito en la tabla InformeMedico!");
          try { window.close(); } catch(e) {}
        } else {
          alert("Error de AppSheet (" + response.status + "): " + resText);
        }
      } catch (error) {
        alert("Error de conexión: " + error.message);
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerText = "💾 Guardar Resumen";
      }
    }  
  </script>
</body>
</html>
