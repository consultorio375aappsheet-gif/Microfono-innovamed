<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dictado Continuo Consulta - DRA. ELIZABETH BALL DE PICÓN | Innova Med</title>
  <style>
    :root {
      --primary-color: #932938; /* Rojo borgoña corporativo */
      --primary-hover: #751f2b;
      --secondary-color: #2c3e50;
      --bg-color: #eef2f5;
      --card-bg: #ffffff;
      --border-color: #d1d5db;
    }

    * {
      box-sizing: border-box;
    }

    body {
      font-family: 'Georgia', 'Times New Roman', serif;
      margin: 0;
      padding: 20px 10px;
      background-color: var(--bg-color);
      color: #222;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }

    /* Contenedor estilo Hoja Médica / Informe */
    .sheet-container {
      width: 100%;
      max-width: 820px;
      background: var(--card-bg);
      padding: 40px 45px;
      border-radius: 6px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08), 0 2px 6px rgba(0, 0, 0, 0.04);
      border: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
    }

    /* Encabezado Corporativo */
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px solid var(--primary-color);
      padding-bottom: 18px;
      margin-bottom: 25px;
      gap: 15px;
      width: 100%;
    }

    .brand-logo {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* Insignia Innova Med */
    .innovamed-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background-color: #f0f7ff;
      border: 1px solid #bae6fd;
      color: #0284c7;
      padding: 4px 10px;
      border-radius: 12px;
      font-family: 'Arial', sans-serif;
      font-size: 11px;
      font-weight: bold;
    }

    .clinic-info {
      text-align: right;
      font-family: 'Arial', sans-serif;
      font-size: 12px;
      color: #444;
      line-height: 1.4;
    }

    .clinic-info strong {
      font-size: 14px;
      color: var(--secondary-color);
      display: block;
      margin-bottom: 2px;
    }

    /* Título de la sección */
    .document-title {
      text-align: center;
      font-size: 20px;
      font-weight: bold;
      color: var(--secondary-color);
      text-decoration: none;
      text-underline-offset: 6px;
      margin-bottom: 20px;
      text-transform: uppercase;
      letter-spacing: 1px;
      width: 100%;
    }

    /* Barra de Estado */
    .status-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      padding: 10px 18px;
      border-radius: 6px;
      margin-bottom: 20px;
      font-family: 'Arial', sans-serif;
      font-size: 14px;
      width: 100%;
    }

    .status-indicator {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      color: #475569;
    }

    .status-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background-color: #94a3b8;
    }

    .status-dot.active {
      background-color: #10b981;
      box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
      animation: pulse 1.5s infinite;
    }

    @keyframes pulse {
      0% { opacity: 1; }
      50% { opacity: 0.4; }
      100% { opacity: 1; }
    }

    /* Controles y Botones */
    .controls {
      display: flex;
      justify-content: center;
      gap: 15px;
      margin-bottom: 20px;
      font-family: 'Arial', sans-serif;
      width: 100%;
    }

    button {
      padding: 12px 22px;
      font-size: 14px;
      font-family: 'Arial', sans-serif;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    button:active {
      transform: translateY(1px);
    }

    #start-btn {
      background-color: #10b981;
      color: white;
      box-shadow: 0 2px 4px rgba(16, 185, 129, 0.2);
    }

    #start-btn:hover:not(:disabled) {
      background-color: #059669;
    }

    #stop-btn {
      background-color: #ef4444;
      color: white;
      box-shadow: 0 2px 4px rgba(239, 68, 68, 0.2);
    }

    #stop-btn:hover:not(:disabled) {
      background-color: #dc2626;
    }

    #save-btn {
      background-color: var(--primary-color);
      color: white;
      width: 100%;
      margin-top: 20px;
      padding: 15px;
      font-size: 15px;
      border-radius: 5px;
      box-shadow: 0 4px 10px rgba(147, 41, 56, 0.2);
    }

    #save-btn:hover:not(:disabled) {
      background-color: var(--primary-hover);
    }

    button:disabled {
      background-color: #cbd5e1 !important;
      color: #94a3b8 !important;
      cursor: not-allowed;
      box-shadow: none !important;
    }

    /* Caja de Transcripción Estilizada */
    textarea {
      width: 100%;
      height: 260px;
      padding: 18px;
      font-family: 'Georgia', 'Times New Roman', serif;
      font-size: 16px;
      color: #1e293b;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      background-color: #fafafa;
      resize: vertical;
      line-height: 1.6;
      box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.03);
    }

    textarea:focus {
      outline: none;
      border-color: var(--primary-color);
      background-color: #ffffff;
    }

    .footer-credits {
      text-align: center;
      font-family: 'Arial', sans-serif;
      font-size: 11px;
      color: #94a3b8;
      margin-top: 15px;
      width: 100%;
    }

    /* Adaptabilidad Móvil */
    @media (max-width: 600px) {
      .sheet-container {
        padding: 20px 18px;
      }

      .header {
        flex-direction: column;
        text-align: center;
        gap: 10px;
      }

      .clinic-info {
        text-align: center;
      }

      .controls {
        flex-direction: column;
      }

      button {
        width: 100%;
      }
    }
  </style>
</head>
<body>

  <div class="sheet-container">
    <!-- Encabezado Corporativo estilo Informe Médico -->
    <div class="header">
      <div class="brand-logo">
        <img src="https://lh3.googleusercontent.com/d/1Tlf8Sn2I2glfRitRd3sbaMan3A1WVaAU" 
             alt="Innova Med Logo" 
             style="height: 160px; width: auto; object-fit: contain;">
        <div>
        </div>
      </div>
      <div class="clinic-info">
        <strong>CONSULTORIO MÉDICO DERMATOLÓGICO</strong>
        DRA. ELIZABETH BALL DE PICÓN <br>
        Caracas 
      </div>
    </div>

    <div class="document-title">Dictado de Consulta Médica</div>

    <!-- Indicador de Estado -->
    <div class="status-container">
      <div class="status-indicator">
        <div id="status-dot" class="status-dot"></div>
        <span id="status">Estado: Detenido</span>
      </div>
      <span style="font-size: 12px; color: #64748b; font-family: sans-serif;">Dictado Inteligente IA</span>
    </div>

    <!-- Botones de Control -->
    <div class="controls">
      <button id="start-btn" onclick="startDictation()">🎙️ Iniciar Escucha</button>
      <button id="stop-btn" onclick="stopDictation()" disabled>⏹ Pausar</button>
    </div>

    <!-- Área de Texto Dictado -->
    <textarea id="transcript-box" placeholder="El texto dictado por la doctora aparecerá en esta sección de forma continua..."></textarea>

    <!-- Botón de Guardado -->
    <button id="save-btn" onclick="sendToAppSheet()">💾 Guardar Resumen</button>
    
    <div class="footer-credits">Innova Med Platform • Sistema de Asistencia Clínica</div>
  </div>

  <script>
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    let recognition;
    let isListening = false;
    let finalTranscript = '';

    const statusDot = document.getElementById('status-dot');

    if (SpeechRecognition) {
      recognition = new SpeechRecognition();
      recognition.continuous = true;
      recognition.interimResults = true;
      recognition.lang = 'es-ES';

      // MANEJO DE RESULTADOS (Evita duplicaciones en Android)
      recognition.onresult = (event) => {
        let interimTranscript = '';

        for (let i = event.resultIndex; i < event.results.length; ++i) {
          if (event.results[i].isFinal) {
            finalTranscript += event.results[i][0].transcript + ' ';
          } else {
            interimTranscript += event.results[i][0].transcript;
          }
        }

        document.getElementById('transcript-box').value = finalTranscript + interimTranscript;
      };
        
      recognition.onspeechend = () => {
        if (isListening) {
          try {
            recognition.start();
          } catch (e) {}
        }
      };

      recognition.onerror = (event) => {
        console.error("Error en reconocimiento de voz:", event.error);
        document.getElementById('status').innerText = "Error: " + event.error;
        if (statusDot) statusDot.classList.remove('active');
      };

      recognition.onend = () => {
        if (isListening) {
          recognition.start();
        } else {
          document.getElementById('status').innerText = "Estado: Pausado";
          if (statusDot) statusDot.classList.remove('active');
          document.getElementById('start-btn').disabled = false;
          document.getElementById('stop-btn').disabled = true;
        }
      };

    } else {
      alert("Tu navegador no soporta el reconocimiento de voz nativo (Web Speech API).");
    }

    function startDictation() {
      if (recognition && !isListening) {
        finalTranscript = document.getElementById('transcript-box').value;
        if (finalTranscript && !finalTranscript.endsWith(' ')) {
          finalTranscript += ' ';
        }
        
        isListening = true;
        recognition.start();
        document.getElementById('status').innerText = "Estado: Escuchando...";
        if (statusDot) statusDot.classList.add('active');
        document.getElementById('start-btn').disabled = true;
        document.getElementById('stop-btn').disabled = false;
      }
    }

    function stopDictation() {
      if (recognition && isListening) {
        isListening = false;
        recognition.stop();
        if (statusDot) statusDot.classList.remove('active');
      }
    }

    // ENVÍO DE DATOS A APPSHEET
    async function sendToAppSheet() {
      const saveBtn = document.getElementById('save-btn');
      const text = document.getElementById('transcript-box').value;

      if (!text.trim()) {
        alert("No hay texto dictado para enviar.");
        return;
      }

      const urlParams = new URLSearchParams(window.location.search);
      const idPaciente = urlParams.get('idPaciente') || urlParams.get('rowId');

      if (!idPaciente) {
        alert("Error: No se encontró el ID del paciente en la URL.");
        return;
      }

      saveBtn.disabled = true;
      saveBtn.innerText = "Guardando...";

      // CREDANCIALES ACTUALIZADAS
      const appId = 'f34969f7-116c-4d6e-bd99-e8988bf64a10';
      const accessKey = 'V2-glUCy-fR4MC-pZrWR-eJYyl-2C87z-ZiKdG-w6Kp1-7Ppep';
      
      const tableName = 'InformeMedico';

      const nuevoInformeId = "INF-" + Date.now();
      
      const hoy = new Date();
      const dia = String(hoy.getDate()).padStart(2, '0');
      const mes = String(hoy.getMonth() + 1).padStart(2, '0');
      const anio = hoy.getFullYear();
      const fechaHoy = `${dia}/${mes}/${anio}`;

      const payload = {
        "Action": "Add",
        "Properties": {
          "Locale": "es-ES",
          "Timezone": "UTC"
        },
        "Rows": [
          {
            "InformeMedID": nuevoInformeId,
            "IDPaciente": decodeURIComponent(idPaciente).trim(),
            "Fecha": fechaHoy,
            "Transcripción": text.trim()
          }
        ]
      };

      const apiUrl = `https://api.appsheet.com/api/v2/apps/${appId}/tables/${tableName}/Action`;

      try {
        const response = await fetch(apiUrl, {
          method: 'POST',
          headers: {
            'ApplicationAccessKey': accessKey,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        const resText = await response.text();

        if (response.ok) {
          alert("¡Informe guardado con éxito en la tabla InformeMedico!");
          try { window.close(); } catch(e) {}
        } else {
          alert(`Error de AppSheet (${response.status}): ${resText}`);
        }
      } catch (error) {
        alert("Error de conexión: " + error.message);
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerText = "💾 Guardar Resumen";
      }
    }  
  </script>
</body>
</html>
